PORT=4000
NODE_ENV=development

MONGODB_ATLAS_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/zynkup

# cloudinary | gcs | local
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=zynkup

# GCS (when MEDIA_STORAGE_PROVIDER=gcs)
GCS_BUCKET=
# GCS_PUBLIC_BASE_URL=

FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- AI (OpenAI — STT, translate, rewrite, suggest, Twin drafts) ---
# Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
# Optional aliases (same key works):
# SPEECH_TO_TEXT_API_KEY=
# TRANSLATE_API_KEY=

# --- Payments: Paystack (default; NOT Flutterwave) ---
# https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional direct MTN MoMo (harder signup than Paystack):
# MTN_MOMO_API_KEY=
# MTN_MOMO_USER_ID=
# MTN_MOMO_API_USER=
# MTN_MOMO_SUBSCRIPTION_KEY=
# PAYMENT_PROVIDER_API_KEY=

# --- WebRTC TURN (Metered.ca free tier is easiest) ---
# https://dashboard.metered.ca/ → TURN credentials
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:a.relay.metered.ca:80,turns:a.relay.metered.ca:443
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Aliases: TURN_URL (single), TURN_PASSWORD

# --- Optional later partners ---
# Status music (B6) — Epidemic Sound / Songtradr licensed API:
# MUSIC_PROVIDER_API_KEY=
# USSD (G2) — Africa's Talking:
# AT_API_KEY=
# AT_USERNAME=
# AT_SHORTCODE=
