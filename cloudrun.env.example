# Copy these into Cloud Run → Variables & Secrets
# Never commit real secret values. Set OPENAI_API_KEY as a Secret on Cloud Run.
PORT=8080
NODE_ENV=production
MONGODB_ATLAS_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/zynkup
MEDIA_STORAGE_PROVIDER=gcs
GCS_BUCKET=zynkup-media
# Optional custom CDN / public base (otherwise https://storage.googleapis.com/BUCKET/...)
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/zynkup-media
CLOUDINARY_UPLOAD_FOLDER=zynkup

FIREBASE_PROJECT_ID=zynkup-9f577
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI — required for live transcription / translation / rewrite / Twin drafts
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Payments — Paystack (not Flutterwave)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional direct MoMo:
# MTN_MOMO_API_KEY=

# WebRTC ICE for 1:1 calls (GET /api/calls/ice-servers). Never commit real TURN secrets.
# Easiest free TURN: Metered.ca dashboard → copy TURN URLs + username/credential
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:a.relay.metered.ca:80,turns:a.relay.metered.ca:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Optional partners (leave empty until you have keys)
# MUSIC_PROVIDER_API_KEY=
# AT_API_KEY=
# AT_USERNAME=
